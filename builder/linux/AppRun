#!/bin/sh
# The Hookshot AppImage: the builder window (builder/linux/hookshot_builder.py), its Python and Hookshot's sources, with the
# Vulkan back end built already. The build tools (clang and lld, a glibc 2.35 sysroot, FFmpeg, SDL2, the Vulkan headers) are
# tools.lock's linux-x64 lines, outside the image: builder/linux/linux_tools.py finds them (the Hookshot Launcher's, or the
# builder's own toolchains folder) and, at the first start, downloads what is missing.
#   Hookshot.AppImage                  the builder window (Play is in the window, once a game is built)
#   Hookshot.AppImage --play           start the game the builder saved, without opening the window
#   Hookshot.AppImage --play <folder>  start the game in that folder
#   Hookshot.AppImage <folder>         the same
#   Hookshot.AppImage --cli <args>     nx2/make_game.py itself, e.g. --cli --nup game.nup --out ~/Games/Hookshot
#   Hookshot.AppImage --launch <dir>  the game folder's launcher: Play, and Update when this builder is newer than the game
#   Hookshot.AppImage --update <dir>  that folder built again with this builder's version (make_game.py --update)
HERE="$(dirname "$(readlink -f "$0")")"
LIB="$HERE/usr/lib/hookshot"
export HOOKSHOT_TOOLS="$HERE/usr/share/hookshot"
export HOOKSHOT_VK_PREBUILT="$LIB/hookshot_vk.so"
# (written into the game folder's hookshot_version.txt, so its launcher finds this builder)
if [ -n "${APPIMAGE:-}" ]; then
    export HOOKSHOT_BUILDER_EXE="$APPIMAGE"
else
    export HOOKSHOT_BUILDER_EXE="$HERE/AppRun"
fi
PY="$HERE/usr/python/bin/python3"
# The build tools' places (EMSDK, HOOKSHOT_SYSROOT, HOOKSHOT_FFMPEG, HOOKSHOT_SDL2, RX_CPM), each downloaded first when it is
# missing ("$@": --gui shows that in a window). A tool that cannot be had is left out: the window opens all the same, and
# its build says what is missing; --cli stops
build_tools() {
    tools_env=$("$PY" -I "$HOOKSHOT_TOOLS/builder/linux/linux_tools.py" env --install "$@") && tools_ok=1 || tools_ok=
    eval "$tools_env"
    [ -n "$tools_ok" ]
}
if [ "${1:-}" = "--cli" ]; then
    shift
    build_tools || exit 1
    exec "$PY" -I "$HOOKSHOT_TOOLS/nx2/make_game.py" "$@"
fi
# Play is the same AppImage: the start script drops this image's libraries, then runs the built game. It needs no build tool.
if [ "${1:-}" = "--play" ]; then
    shift
    exec "$HOOKSHOT_TOOLS/builder/linux/hookshot-launch" "$@"
fi
if [ -n "${1:-}" ] && [ -d "$1" ]; then
    exec "$HOOKSHOT_TOOLS/builder/linux/hookshot-launch" "$1"
fi
build_tools --gui || true
exec "$PY" -I "$HOOKSHOT_TOOLS/builder/linux/hookshot_builder.py" "$@"
