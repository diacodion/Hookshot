#!/bin/sh
# The Hookshot AppImage: the Linux builder, for the command line. Its Python, Hookshot's sources and nx2/make_game.py, with the
# Vulkan back end built already. It has no window: players use the Hookshot Launcher, which unpacks this AppImage and runs
# make_game.py with its Python. The build tools (clang and lld, a glibc 2.35 sysroot, FFmpeg, SDL2, the Vulkan headers) are
# tools.lock's linux-x64 lines, outside the image: builder/linux/linux_tools.py finds them (the Hookshot Launcher's, or the
# builder's own toolchains folder) and, for --cli, downloads what is missing.
#   Hookshot.AppImage --cli <args>     nx2/make_game.py itself, e.g. --cli --nup game.nup --out ~/Games/Hookshot
#                                      (RecompLauncher's prepare: --cli --prepare --game <copy>)
#   Hookshot.AppImage --play           start the game in ~/Games/Hookshot
#   Hookshot.AppImage --play <folder>  start the game in that folder (RecompLauncher's start)
#   Hookshot.AppImage <folder>         the same
#   Hookshot.AppImage --launch <dir>  the same (a game folder's hookshot, builder/linux/hookshot-folder, when --cli built it)
#   Hookshot.AppImage                  a message: get the Hookshot Launcher
HERE="$(dirname "$(readlink -f "$0")")"
LIB="$HERE/usr/lib/hookshot"
export HOOKSHOT_TOOLS="$HERE/usr/share/hookshot"
export HOOKSHOT_VK_PREBUILT="$LIB/hookshot_vk.so"
# (written into the game folder's hookshot_version.txt, so its launcher finds this builder)
if [ -n "${APPIMAGE:-}" ]; then
    export HOOKSHOT_BUILDER_EXE="$APPIMAGE"
else
    export HOOKSHOT_BUILDER_EXE="$HERE/AppRun"
fi
PY="$HERE/usr/python/bin/python3"
# The build tools' places (EMSDK, HOOKSHOT_SYSROOT, HOOKSHOT_FFMPEG, HOOKSHOT_SDL2, RX_CPM), each downloaded first when it is
# missing, its progress on stderr. A tool that cannot be had stops --cli
build_tools() {
    tools_env=$("$PY" -I "$HOOKSHOT_TOOLS/builder/linux/linux_tools.py" env --install) && tools_ok=1 || tools_ok=
    eval "$tools_env"
    [ -n "$tools_ok" ]
}
if [ "${1:-}" = "--cli" ]; then
    shift
    build_tools || exit 1
    exec "$PY" -I "$HOOKSHOT_TOOLS/nx2/make_game.py" "$@"
fi
# Play is the same AppImage: the start script drops this image's libraries, then runs the built game. It needs no build tool.
if [ "${1:-}" = "--play" ]; then
    shift
    exec "$HOOKSHOT_TOOLS/builder/linux/hookshot-launch" "$@"
fi
if [ "${1:-}" = "--launch" ] && [ -n "${2:-}" ] && [ -d "$2" ]; then
    exec "$HOOKSHOT_TOOLS/builder/linux/hookshot-launch" "$2"
fi
if [ -n "${1:-}" ] && [ -d "$1" ]; then
    exec "$HOOKSHOT_TOOLS/builder/linux/hookshot-launch" "$1"
fi
# Anything else (started from the applications menu or a file manager): no window, a message
MESSAGE="The Hookshot Builder has no window of its own: the Hookshot Launcher builds the game and starts it. Get the launcher from https://hookshot.magicbean.dev/download"
echo "$MESSAGE" >&2
if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ ! -t 2 ]; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --title="Hookshot Builder" --text="$MESSAGE" >/dev/null 2>&1 || true
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Hookshot Builder" --msgbox "$MESSAGE" >/dev/null 2>&1 || true
    fi
fi
exit 1
